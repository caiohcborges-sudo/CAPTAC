<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0B0D10" android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Copiloto de Atendimento" android:textColor="#FFFFFF"
            android:textSize="22sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Nada é enviado sem o seu toque." android:textColor="#8B949E" />

        <Button android:id="@+id/btUpdate" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:backgroundTint="#1F6FEB"
            android:text="ATUALIZAR APP" />
        <TextView android:id="@+id/tvVer" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="4dp"
            android:textColor="#58A6FF" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvHealth" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="8dp"
            android:background="#161B22" android:padding="10dp"
            android:textColor="#E6EDF3" android:textSize="13sp" />
        <Button android:id="@+id/btSim" android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SIMULAR UMA MENSAGEM (testa API + IA sem o RandoChat)" />

        <Switch android:id="@+id/swAtivo" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Receber sugestões"
            android:textColor="#E6EDF3" android:layout_marginBottom="12dp" />

        <Switch android:id="@+id/swAuto" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Modo AUTOMÁTICO (a IA responde sozinha)"
            android:textColor="#00C875" />
        <TextView android:id="@+id/tvAutoInfo" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="12dp"
            android:textColor="#8B949E" android:textSize="12sp"
            android:text="Desligado = semi-automático (você aprova cada resposta). Ligado = envia sozinha após o delay; o 1º toque sempre avisa que é uma IA." />

        <EditText android:id="@+id/etUrl" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="URL da API"
            android:inputType="textUri" android:textColor="#E6EDF3" android:textColorHint="#6E7681" />
        <EditText android:id="@+id/etToken" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Token secreto (X-Rando-Token)"
            android:inputType="textPassword" android:textColor="#E6EDF3" android:textColorHint="#6E7681" />
        <EditText android:id="@+id/etPkg" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Pacote do app alvo (vírgula p/ vários)"
            android:inputType="text" android:textColor="#E6EDF3" android:textColorHint="#6E7681" />

        <Button android:id="@+id/btSalvar" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="SALVAR" />

        <Button android:id="@+id/btTest" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="TESTAR CONEXÃO API" />

        <TextView android:id="@+id/tvPerm" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:textColor="#E6EDF3" />
        <Button android:id="@+id/btNotif" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Conceder acesso às notificações" />
        <Button android:id="@+id/btOverlay" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Permitir sobrepor a outros apps" />

        <Button android:id="@+id/btBattery" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Ignorar otimização de bateria (recomendado)" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Diagnóstico (o que o app está vendo)"
            android:textColor="#F5A524" android:textStyle="bold" />
        <Button android:id="@+id/btUsePkg" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="USAR PACOTE DA ÚLTIMA NOTIFICAÇÃO RECEBIDA" />
        <TextView android:id="@+id/tvDiag" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:background="#161B22"
            android:padding="12dp" android:textColor="#C9D1D9" android:textSize="11sp"
            android:text="Nenhuma notificação vista ainda. Se continuar vazio com mensagens chegando, falta o acesso às notificações." />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Últimas sugestões"
            android:textColor="#00C875" android:textStyle="bold" />
        <TextView android:id="@+id/tvHist" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:background="#161B22"
            android:padding="12dp" android:textColor="#E6EDF3" android:text="—" />
    </LinearLayout>
</ScrollView>
