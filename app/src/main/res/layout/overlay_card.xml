<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="#EE161B22" android:padding="12dp">

    <TextView android:id="@+id/ovQueue" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="#00C875" android:textSize="12sp"
        android:textStyle="bold" android:visibility="gone" />
    <TextView android:id="@+id/ovFrom" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="#8B949E" android:textSize="12sp" />
    <TextView android:id="@+id/ovReply" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:textColor="#FFFFFF" android:textSize="15sp" />
    <EditText android:id="@+id/ovEditText" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:visibility="gone" android:inputType="textMultiLine"
        android:textColor="#FFFFFF" android:textSize="15sp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="horizontal">
        <Button android:id="@+id/ovOk" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1.4" android:textSize="11sp" android:backgroundTint="#00C875" android:text="APROVAR E ENVIAR" />
        <Button android:id="@+id/ovRegen" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="0.6" android:textSize="14sp" android:backgroundTint="#30363D" android:text="↻" />
        <Button android:id="@+id/ovEdit" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="11sp" android:backgroundTint="#30363D" android:text="EDITAR" />
        <Button android:id="@+id/ovNo" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="11sp" android:backgroundTint="#E11D48" android:text="DESCARTAR" />
    </LinearLayout>
</LinearLayout>
